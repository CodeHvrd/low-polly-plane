# Puerto asignado por Render automáticamente (en local usa 3000)
PORT=3000

# Connection string de Neon (usar el endpoint "-pooler" de Neon)
DATABASE_URL=postgres://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Secreto largo aleatorio para firmar tokens de sesión HMAC-SHA256
AUTH_SECRET=cambiame-por-una-clave-secreta-larga-y-unica

# Orígenes permitidos para CORS separados por coma
CORS_ORIGIN=https://codehvrd.github.io,http://localhost:8080,http://127.0.0.1:8080

# Opcional: validación futura de OAuth / Steam
GOOGLE_CLIENT_ID=
STEAM_WEB_API_KEY=
