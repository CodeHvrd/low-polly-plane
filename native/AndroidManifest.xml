<?xml version="1.0" encoding="utf-8"?>
<!--
  PAPERCRASH — manifiesto del APK.

  ── Puntos que importan ──
  · Sin permiso de INTERNET a propósito: el juego va EMPAQUETADO en assets/www,
    así que no necesita red. Un APK sin permisos es la mejor garantía de que
    funciona offline y de que no llama a ningún lado.
  · `hardwareAccelerated` y WebGL: sin esto el canvas no acelera y el juego va
    a 10 fps.
  · `screenOrientation="portrait"`: el juego pasó a VERTICAL. En apaisado la
    rueda táctil tapaba el corredor y el juego se sentía como una pantalla de
    interfaz con un poco de juego atrás. El HUD y los mandos se rediseñaron para
    aprovechar el alto de la pantalla.
  · `resizeableActivity` para que funcione en pantallas partidas y plegables.
  · `configChanges` evita que Android recree la actividad al girar o al mostrar
    el teclado, que reiniciaría la partida.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.papercrash.game"
    android:versionCode="1"
    android:versionName="1.0.0">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />

    <uses-feature android:glEsVersion="0x00020000" android:required="true" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:hardwareAccelerated="true"
        android:allowBackup="true"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode"
            android:launchMode="singleTask"
            android:resizeableActivity="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
